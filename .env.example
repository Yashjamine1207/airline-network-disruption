# Airline Network Disruption Intelligence
# Copy this file to .env only if a local environment variable is needed.
# Never commit the real .env file.

# Optional local project root override.
# PROJECT_ROOT=C:\Users\your_username\path\to\airline-network-disruption-intelligence

# Optional Kaggle API credentials.
# These are not required while using the already downloaded local CSV.
# If Kaggle API download is used later, add real values only to your local .env file.
# KAGGLE_USERNAME=
# KAGGLE_KEY=

# Optional MLflow tracking URI.
# Keep local experiment outputs outside Git.
# MLFLOW_TRACKING_URI=file:./mlruns

# Optional setting for TensorFlow logging.
# TF_CPP_MIN_LOG_LEVEL=2

# Optional setting to control the number of threads used by numerical libraries.
# OMP_NUM_THREADS=
# MKL_NUM_THREADS=